name: APXN Fix Legacy Article Editor and Cover Image

on:
  push:
    branches:
      - cloudflare-migration
    paths:
      - ".github/workflows/apxn-fix-legacy-article-editor.yml"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: apxn-legacy-blog-article-fix-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  fix-legacy-article:
    if: ${{ github.ref == 'refs/heads/cloudflare-migration' }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout the exact APXN website branch
        uses: actions/checkout@v4
        with:
          ref: cloudflare-migration
          fetch-depth: 0

      - name: Restore original article sections in editor and fix image saving
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          from html import unescape
          import json
          import re
          
          ADMIN = Path('blog-admin/index.html')
          BACKEND = Path('api/blog-admin-manage.js')
          MANIFEST = Path('data/blog-articles.json')
          ARTICLE = Path('blog/articles/what-are-apxn-points.html')
          
          
          def replace_once(source, old, new, label):
              if source.count(old) != 1:
                  raise RuntimeError(f'{label}: expected one anchor, got {source.count(old)}')
              return source.replace(old, new, 1)
          
          # 1. Restore the existing published article's editing data by extracting
          # the real words and sections from its ORIGINAL HTML, not fabricating copy.
          manifest = json.loads(MANIFEST.read_text(encoding='utf8'))
          item = next((x for x in manifest['articles'] if x.get('id') == 'apxn-001'), None)
          if not item or item.get('slug') != 'what-are-apxn-points':
              raise RuntimeError('Original APXN Points article was not found; no files changed')
          page = ARTICLE.read_text(encoding='utf8')
          if not item.get('content') or not item['content'].get('sections'):
              start = re.search(r'<div\s+class=["\']article-body["\']\s*>', page, re.I)
              if not start:
                  raise RuntimeError('Missing original published article body')
              ending = re.search(r'\n\s*</div>\s*\n\s*<!--\s*Disclaimer\s*-->', page[start.end():], re.I)
              if not ending:
                  raise RuntimeError('Unexpected legacy article structure; no files changed')
              body = page[start.end():start.end()+ending.start()]
              tags = re.finditer(r'<(?P<tag>h2|h3|p|li)\b[^>]*>(?P<html>[\s\S]*?)</(?P=tag)>', body, re.I)
              def clean(markup):
                  value = re.sub(r'<[^>]+>', ' ', markup)
                  return re.sub(r'\s+', ' ', unescape(value)).strip()
              intro, groups, faq, conclusion = [], [], [], []
              state='intro'; current=None
              for match in tags:
                  tag = match.group('tag').lower(); content = clean(match.group('html'))
                  if not content: continue
                  if tag == 'h2':
                      v = content.lower()
                      if v == 'frequently asked questions': state='faq';current=None;continue
                      if v in ('final thoughts', 'conclusion'): state='conclusion';current=None;continue
                      state='section'; current={'heading':content,'paragraphs':[]};groups.append(current);continue
                  if state == 'faq':
                      if tag=='h3': faq.append({'question':content,'answer':'','evidence_ids':[]})
                      elif faq: faq[-1]['answer'] += (' ' if faq[-1]['answer'] else '') + content
                      continue
                  if state=='conclusion':
                      if tag in ('p','li'): conclusion.append(content)
                      continue
                  if state=='section':
                      if tag == 'h3': current['paragraphs'].append({'text':content,'evidence_ids':[]})
                      elif tag in ('p','li'):current['paragraphs'].append({'text':content,'evidence_ids':[]})
                      continue
                  if tag in ('p','li'):intro.append(content)
              faq=[x for x in faq if x['answer']]
              if len(groups)<9 or not intro or not conclusion or len(faq)<3:
                  raise RuntimeError(f'Extraction failed: {len(groups)} sections, {len(intro)} intro, {len(conclusion)} conclusion, {len(faq)} FAQs')
              for sec in groups:
                  if not sec['paragraphs']:
                      raise RuntimeError('An extracted section has no original content')
              def par(text):return {'text':text,'evidence_ids':[]}
              item['content']={
                  'title':item['title'],
                  'description':item['description'],
                  'keywords':item.get('keywords',[]),
                  'intro':par('\n\n'.join(intro)),
                  'sections':groups,
                  'faq':faq,
                  'conclusion':par('\n\n'.join(conclusion))
              }
              # Preserve original title, published URL, publication date and every article HTML byte.
              MANIFEST.write_text(json.dumps(manifest,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
              print(f'Recovered apxn-001: {len(groups)} sections, {len(faq)} FAQs, {len(intro)} intro paragraphs')
          else:
              print('apxn-001 content already present; existing editorial data preserved')
          
          # 2. Teach the saved-page editor to recognize old pages without the new
          # 'Editorial note' / <figure> template, preserving original body on image-only edits.
          source=BACKEND.read_text(encoding='utf8')
          insert_before='async function createBlob(content, encoding) {'
          legacy_renderer=r'''/**
           * Legacy APXN page layout (before the current blog generator).
           * Preserve the original body, callouts, CTA and footer for image-only edits.
           * Replace body only if the editor actually changed the text.
           */
          function renderLegacyTemplate(template, article, preserveBody) {
            const canonical = articleUrl(article.slug);
            const image = article.image || DEFAULT_IMAGE;
            let html = template;
            html = replaceRequired(html, /<title>[\s\S]*?<\/title>/i,
              `<title>${esc(article.title)}</title>`, 'LEGACY_TITLE');
            for (const [kind, key, value] of [
              ['name','description',article.description],
              ['name','keywords',article.keywords.join(', ')],
              ['property','og:title',article.title],
              ['property','og:description',article.description],
              ['property','og:url',canonical],
              ['property','og:image',image],
              ['name','twitter:title',article.title],
              ['name','twitter:description',article.description],
              ['name','twitter:image',image]
            ]) {
              html = replaceMeta(html, kind, key, value);
            }
            html = replaceRequired(html, /<link\s+rel="canonical"\s+href="[^"]*"\s*\/?\s*>/i,
              `<link rel="canonical" href="${esc(canonical)}">`, 'LEGACY_CANONICAL');
          
            // Keep the original styled headline if its visible title has not changed.
            const hero = /(<h1\b[^>]*>)[\s\S]*?(<\/h1>)/i;
            const titleOfHero = /<h1\b[^>]*>([\s\S]*?)<\/h1>/i.exec(template)?.[1]
              ?.replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim() || '';
            if (!preserveBody) {
              if (titleOfHero !== article.title) {
                html = replaceRequired(html, hero, (_,a,z)=>`${a}${esc(article.title)}${z}`, 'LEGACY_HERO_TITLE');
              }
              html = replaceRequired(html,
                /(<\/h1>\s*<p\b[^>]*>)[\s\S]*?(<\/p>)/i,
                (_,a,z)=>`${a}${esc(article.description)}${z}`, 'LEGACY_HERO_DESC');
            }
            html = html.replace(/(<span>\s*)\d+\s+min read(\s*<\/span>)/i,
              (_,a,z)=>`${a}${article.reading_minutes} min read${z}`);
          
            // Image from this older page did not have a main cover figure.
            // Add/update ONE managed cover, never change site/header/CTA logos.
            const managedCover = /<figure\s+data-apxn-managed-cover="true"[\s\S]*?<\/figure>\s*/i;
            html = html.replace(managedCover, '');
            if (image !== DEFAULT_IMAGE) {
              const cover = `<figure data-apxn-managed-cover="true" class="mb-12" style="margin:0 0 2.8rem">\n`+
                `<img src="${esc(image)}" alt="${esc(article.title)}" `+
                `style="display:block;width:100%;height:auto;max-height:620px;object-fit:cover;border:1px solid #1e293b;border-radius:18px" loading="eager">\n</figure>\n`;
              html = replaceRequired(html, /<div\s+class="article-body"\s*>/i,
                match=>cover+match, 'LEGACY_COVER');
            }
          
            if (!preserveBody) {
              // This boundary is outside the original article-body. Keep its disclaimer,
              // related resources, CTA, footer and all navigation intact.
              const open = /<div\s+class="article-body"\s*>/i.exec(html);
              if (!open) fail('LEGACY_ARTICLE_BODY_MISSING', 409);
              const start = open.index + open[0].length;
              const rest = html.slice(start);
              const close = /\n\s*<\/div>\s*\n\s*<!--\s*Disclaimer\s*-->/i.exec(rest);
              if (!close) fail('LEGACY_ARTICLE_BODY_BOUNDARY_MISSING', 409);
              const closePos = start + close.index;
              // Retain the closing div outside the replacement region.
              html = html.slice(0,start) + renderArticleCore(article) + html.slice(closePos);
            }
          
            html = replaceRequired(html,
              /const\s+APXN_ARTICLE_SHARE\s*=\s*\{[\s\S]*?\};/,
              `const APXN_ARTICLE_SHARE = {title:${safeJson(article.title)},url:${safeJson(canonical)}};`,
              'LEGACY_SHARE');
            html = rewriteStructuredData(html, article, image, canonical, today());
            return html;
          }
          
          function equivalentEditorialContent(x,y) {
            if (!x || !y) return false;
            const simplify = c => ({
              intro: c.intro?.text || '',
              sections: (c.sections || []).map(s=>({heading:s.heading,
                paragraphs:(s.paragraphs||[]).map(p=>p.text)})),
              faq: (c.faq||[]).map(f=>({question:f.question,answer:f.answer})),
              conclusion: c.conclusion?.text || ''
            });
            return JSON.stringify(simplify(x)) === JSON.stringify(simplify(y));
          }
          
          '''
          if 'function renderLegacyTemplate(' not in source:
              source=replace_once(source,insert_before,legacy_renderer+insert_before,'legacy renderer')
          
          old_template="""      if (!candidate) fail('PUBLISHED_TEMPLATE_NOT_FOUND',409);
                template=await readFile(candidate.path);"""
          new_template="""      if (!candidate) fail('PUBLISHED_TEMPLATE_NOT_FOUND',409);
                template=await readFile(candidate.path);"""
          # Reuse the most recent publishing template for NEW articles. The original first
          # article used the now-unsupported legacy structure.
          source=replace_once(source,
              "const candidate=manifest.articles.find(a=>a.id!==article.id && a.status==='published' &&",
              "const candidate=[...manifest.articles].reverse().find(a=>a.id!==article.id && a.status==='published' &&",
              'modern template selection')
          source=replace_once(source,
              '    const html=renderFromTemplate(template,article,manifest,oldPublished);',
              '''    const originalBodyUnchanged = current && equivalentEditorialContent(approved.content, current.content);
              const legacy = !/<strong>\\s*Editorial note:/i.test(template);
              const html = legacy
                ? renderLegacyTemplate(template, article, !!originalBodyUnchanged)
                : renderFromTemplate(template,article,manifest,oldPublished);''',
              'legacy handling')
          BACKEND.write_text(source,encoding='utf8')
          print('Adjusted legacy article image/title/content renderer and future new-article template selection')
          
          # No change to blog-admin layout is needed: it already reads article.content
          # from the manifest, which the migration above now restores.
          assert ADMIN.exists()
          print('Existing admin UI preserved unchanged')
          PY

      - name: Validate full article, editorial data and JavaScript
        shell: bash
        run: |
          set -euo pipefail
          node --check api/blog-admin-manage.js
          python3 - <<'PY'
          import json
          from pathlib import Path
          data=json.loads(Path('data/blog-articles.json').read_text(encoding='utf8'))
          a=next(x for x in data['articles'] if x['id']=='apxn-001')
          assert a['status']=='published'
          assert a['slug']=='what-are-apxn-points'
          assert len(a['content']['sections'])>=9
          assert len(a['content']['faq'])>=3
          assert a['content']['intro']['text']
          assert a['content']['conclusion']['text']
          article=Path('blog/articles/what-are-apxn-points.html').read_text(encoding='utf8')
          assert 'What exactly are APXN Points?' in article
          assert 'How the 12-hour APXN claim cycle works' in article
          assert 'Final thoughts' in article
          backend=Path('api/blog-admin-manage.js').read_text(encoding='utf8')
          assert 'function renderLegacyTemplate(' in backend
          assert 'function equivalentEditorialContent(' in backend
          print('Verified legacy article sections:',len(a['content']['sections']))
          print('Verified existing FAQs:',len(a['content']['faq']))
          print('Original published HTML remains untouched until the owner saves an edit.')
          PY
          git diff --check
          git diff --exit-code -- blog/articles/what-are-apxn-points.html

      - name: Save the repaired editor backend and recovered editorial data
        shell: bash
        run: |
          set -euo pipefail
          git config user.name "APXN Blog Bot"
          git config user.email "actions@github.com"
          git add -- data/blog-articles.json api/blog-admin-manage.js
          if git diff --cached --quiet; then
            echo "Nothing to change; repair already applied."
            exit 0
          fi
          git commit -m "fix(blog-admin): restore legacy article sections and image updates"
          git pull --rebase origin cloudflare-migration
          git push origin HEAD:cloudflare-migration

