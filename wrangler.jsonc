
{
  "name": "apxn-landing",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BLOG_GITHUB_REPO": "moh124moh124cry/apxn-landing",
    "BLOG_GITHUB_BRANCH": "cloudflare-migration"
  },
  "assets": {
    "directory": "./.cloudflare-static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  }
}
